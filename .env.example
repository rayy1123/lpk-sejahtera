# ==============================================================================
# PT. Sejahtera Abadi Bersama — Environment Configuration Template
# ==============================================================================
# PERINGATAN: JANGAN masukkan secret, password, atau API key asli ke file ini.
# Salin file ini menjadi .env sebelum menjalankan aplikasi secara lokal.

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Backend Go API Configuration ---
PORT=8080
ENV=development # development | staging | production
ALLOWED_ORIGINS=http://localhost:3000,https://lpk-sejahtera.vercel.app

# Database Connection (Supabase PostgreSQL / Direct Pooler)
DATABASE_URL=postgres://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-ops

# Storage Bucket Names
SUPABASE_PRIVATE_BUCKET=student-documents
SUPABASE_PUBLIC_BUCKET=public-assets
